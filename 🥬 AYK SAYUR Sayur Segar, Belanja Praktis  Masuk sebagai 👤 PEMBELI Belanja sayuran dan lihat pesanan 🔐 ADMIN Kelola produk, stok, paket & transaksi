async function changeBranchPassword(id){let np=prompt("Password baru untuk "+branchName(id)+" (minimal 6 karakter):");if(np===null)return;if(np.length<6)return toast("Password minimal 6 karakter");try{if(sbReady){let {error}=await sb.from("admin_cabang").update({password:np}).eq("cabang_id",id);if(error)throw error;}let a=branchAdmins.filter(x=>x.branchId!==id);a.push({branchId:id,password:np});branchAdmins=a;localStorage.setItem("aykBranchAdmins",JSON.stringify(a));toast("Password cabang berhasil diubah")}catch(e){toast("Gagal ubah password: "+e.message)}}
async function manageBranch(id){currentBranchId=id;await loadBranchOverrides(id);let box=document.getElementById("branchManage");if(!box)return;box.innerHTML=`<div class="panel"><h3>⚙️ Harga & Stok: ${branchName(id)}</h3><p><small>Kosongkan harga khusus untuk mengikuti harga pusat. Stok cabang wajib diisi.</small></p>${products.map(p=>{let ov=branchOverrides[String(p.id)]||{};return `<div style="border-top:1px solid #eee;padding:10px 0"><b>${p.name}</b><input id="bp_${p.id}" class="input" type="number" value="${ov.price??""}" placeholder="Harga khusus (kosong = harga pusat ${p.basePrice??p.price})"><input id="bs_${p.id}" class="input" type="number" value="${ov.stock??0}" placeholder="Stok cabang"><button class="btn green" onclick="saveBranchProduct('${id}',${p.id})">Simpan</button></div>`}).join("")}</div>`}
async function saveBranchProduct(branchId,pid){let priceEl=document.getElementById("bp_"+pid),stockEl=document.getElementById("bs_"+pid);let price=priceEl.value.trim()===""?null:+priceEl.value,stock=+stockEl.value;if(stock<0)return toast("Stok tidak boleh negatif");try{if(sbReady){let {error}=await sb.from("produk_cabang").upsert({cabang_id:branchId,produk_id:pid,harga_khusus:price,stock},{onConflict:"cabang_id,produk_id"});if(error)throw error;}branchOverrides[String(pid)]={price,stock};toast("Harga & stok cabang disimpan")}catch(e){toast("Gagal simpan cabang: "+e.message)}}
function renderAdminReport(c){
  const rows={};
  orders.filter(o=>adminMode==="pusat"||String(o.branchId||"pusat")===String(currentBranchId)).forEach(o=>{
    (o.items||[]).forEach(i=>{
      const key=i.name;
      if(!rows[key]) rows[key]={name:key,stockBefore:null,sold:0,stockAfter:null,omzet:0,modal:0,untung:0};
      const r=rows[key];
      if(i.stockBefore!=null){
        if(r.stockBefore==null || new Date(o.date)<new Date(r.firstDate||o.date)){r.stockBefore=Number(i.stockBefore);r.firstDate=o.date}
        r.stockAfter=Number(i.stockAfter);
      }
      r.sold+=Number(i.qty||0);
      r.omzet+=Number(i.price||0)*Number(i.qty||0);
      r.modal+=Number(i.cost||0)*Number(i.qty||0);
      r.untung+=((Number(i.price||0)-Number(i.cost||0))*Number(i.qty||0));
    });
  });
  const data=Object.values(rows);
  const omzet=data.reduce((s,r)=>s+r.omzet,0), modal=data.reduce((s,r)=>s+r.modal,0), untung=data.reduce((s,r)=>s+r.untung,0), sold=data.reduce((s,r)=>s+r.sold,0);
  c.innerHTML=`<h2>📈 Laporan</h2><div class="cards"><div class="stat"><small>Total Terjual</small><b>${sold}</b></div><div class="stat"><small>Omzet Barang</small><b>${rp(omzet)}</b></div><div class="stat"><small>Total Modal</small><b>${rp(modal)}</b></div><div class="stat"><small>Keuntungan</small><b>${rp(untung)}</b></div></div><div class="panel"><b>📦 Laporan Stok & Penjualan</b><p><small>Stok awal diambil dari stok sebelum transaksi pertama yang tercatat. Stok akhir adalah stok setelah transaksi terakhir.</small></p><div style="overflow:auto"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr><th style="text-align:left;padding:8px">Produk</th><th>Stok Awal</th><th>Terjual</th><th>Stok Akhir</th><th>Omzet</th><th>Modal</th><th>Untung</th></tr></thead><tbody>${data.map(r=>`<tr><td style="padding:8px;border-top:1px solid #eee">${r.name}</td><td style="text-align:center;border-top:1px solid #eee">${r.stockBefore==null?"-":r.stockBefore}</td><td style="text-align:center;border-top:1px solid #eee">${r.sold}</td><td style="text-align:center;border-top:1px solid #eee">${r.stockAfter==null?"-":r.stockAfter}</td><td style="text-align:right;border-top:1px solid #eee">${rp(r.omzet)}</td><td style="text-align:right;border-top:1px solid #eee">${rp(r.modal)}</td><td style="text-align:right;border-top:1px solid #eee">${rp(r.untung)}</td></tr>`).join("")||`<tr><td colspan="7" style="padding:15px;text-align:center">Belum ada transaksi.</td></tr>`}</tbody></table></div></div>`;
}

