function showPayInfo(){let m=document.getElementById("payMethod")?.value,e=document.getElementById("payInfo");if(!e)return;if(m==="TRANSFER"){e.style.display="block";e.innerHTML=`<b>Transfer Bank</b><br>${payment.bank} — ${payment.account}<br>a.n. ${payment.holder}`}else if(m==="QRIS"){e.style.display="block";e.innerHTML=`<b>QRIS</b><br>${payment.qris}<br><small>Setelah pembayaran, konfirmasi kepada admin.</small>`}else{e.style.display="none";e.innerHTML=""}}
async function finishOrder(){let n=document.getElementById("bn").value.trim(),p=document.getElementById("bp").value.trim(),a=document.getElementById("ba").value.trim(),method=document.getElementById("payMethod").value,file=document.getElementById("proof").files[0],zone=document.getElementById("shipZone").value;if(!n||!p||!a)return toast("Lengkapi data pembeli");if(!Object.keys(cart).length)return toast("Keranjang kosong");if(method!=="COD"&&!file)return toast("Upload bukti pembayaran");let sub=getCartSubtotal(),ongkir=getShipping(zone,sub),saveOrder=async(proof)=>{let profit=0,items=[];for(let x of cartLines()){let stockNeed=x.q,p=x.p;if(p.stock<stockNeed)return toast("Stok tidak cukup: "+p.name);let stockBefore=p.stock;p.stock-=stockNeed;let stockAfter=p.stock;let cost=p.cost||0;if(x.type==="package"){let u=(p.packageUnit||"").toLowerCase();let m=u.match(/([0-9]+(?:\.[0-9]+)?)\s*gram/);if(m&&(String(p.unit||"").toLowerCase()==="kg")){cost=cost*(parseFloat(m[1])/1000)}else if(m&&String(p.unit||"").toLowerCase()==="gram"){cost=cost*(parseFloat(m[1])/1000)}else{cost=cost} }profit+=(x.price-cost)*x.q;items.push({id:p.id,name:p.name,qty:x.q,type:x.type,price:x.price,cost:cost,package:x.type==="package",packageUnit:x.packageUnit||"",stockBefore:stockBefore,stockAfter:stockAfter})}let status=method==="COD"?"Menunggu diproses":"Menunggu konfirmasi pembayaran";let o={id:"AYK-"+Date.now().toString().slice(-6),date:new Date().toLocaleString("id-ID"),name:n,phone:p,address:a,branchId:currentBranchId,branchName:branchName(currentBranchId),latitude:parseFloat(document.getElementById("bLat")?.value||"")||null,longitude:parseFloat(document.getElementById("bLng")?.value||"")||null,subtotal:sub,shipping:ongkir,shippingZone:zone,total:sub+ongkir,profit,items,payment:method,status,proof:proof||""};try{if(sbReady){for(let x of cartLines()) await syncProductForCurrentBranch(x.p);await syncOrder(o)}orders.unshift(o);cart={};save();document.getElementById("cartModal").remove();renderShop();toast(sbReady?"Pesanan tersimpan online":"Pesanan berhasil dibuat")}catch(e){console.error(e);toast("Gagal menyimpan online: "+e.message);await loadOnlineData()}};if(file){let r=new FileReader();r.onload=()=>saveOrder(r.result);r.readAsDataURL(file)}else saveOrder("")}
async function cancelBuyerOrder(id){let o=orders.find(x=>x.id===id);if(!o)return;if(o.status!=="Menunggu diproses"){return toast("Pesanan sudah diproses dan tidak dapat dibatalkan")};if(!confirm("Batalkan pesanan "+id+"? Stok akan dikembalikan."))return;try{for(let i of (o.items||[])){let p=products.find(x=>String(x.id)===String(i.id));if(!p){p=products.find(x=>x.name===i.name)}if(p){p.stock=Number(p.stock||0)+Number(i.qty||0);if(sbReady)await syncProductForCurrentBranch(p)}}o.status="Dibatalkan";save();if(sbReady){await syncOrderStatus(id,"Dibatalkan")}toast("Pesanan dibatalkan dan stok dikembalikan");if(document.getElementById("buyerOrders")){document.getElementById("buyerOrders").remove();showBuyerOrders()}if(role==="admin")adminPage("orders",document.querySelectorAll(".tab")[2])}catch(e){console.error(e);toast("Gagal membatalkan pesanan: "+e.message);await loadOnlineData()}}
