<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#eef3ec;color:#1d2920}.app{max-width:480px;margin:auto;min-height:100vh;background:#fff;padding-bottom:75px}
header{background:#287a3d;color:white;padding:22px 18px;border-radius:0 0 22px 22px}header h1{margin:0;font-size:28px}header p{margin:5px 0 0}.page{padding:16px}
.role{margin-top:35px;text-align:center}.role h2{font-size:22px}.role-card{border:1px solid #dce6da;border-radius:17px;padding:18px;margin:12px 0;cursor:pointer;background:#fff}.role-card:hover{background:#f3f8f1}.role-icon{font-size:40px}.role-card b{display:block;font-size:18px;margin:6px}.role-card small{color:#6b746c}
.login{max-width:360px;margin:35px auto}.input{width:100%;padding:12px;border:1px solid #d5ddd3;border-radius:10px;margin:6px 0 12px}.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:bold;cursor:pointer}.green{background:#287a3d;color:#fff}.light{background:#edf4eb}.red{background:#fdecec;color:#b52a2a}.full{width:100%}
.top{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid #eee;gap:6px}.top b{color:#287a3d}.tabs{display:flex;gap:6px;padding:10px;overflow:auto}.tab{border:0;background:#edf4eb;padding:9px 11px;border-radius:10px;white-space:nowrap;font-weight:bold}.tab.active{background:#287a3d;color:#fff}
.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.product{border:1px solid #e1e9df;border-radius:13px;padding:10px}.emoji{font-size:40px;text-align:center;background:#eef5eb;border-radius:10px;padding:10px}.product h3{margin:7px 0 3px;font-size:15px}.price{font-weight:bold;color:#287a3d}.add{width:100%;margin-top:8px}.package{margin-top:7px;background:#fff4d8;border:1px solid #f1d68a;border-radius:9px;padding:7px;font-size:12px}.package b{color:#9a6500}.cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat{padding:13px;border:1px solid #e1e9df;border-radius:13px}.stat small{color:#697269}.stat b{display:block;color:#287a3d;font-size:17px;margin-top:5px}.panel{border:1px solid #e1e9df;border-radius:13px;padding:13px;margin:10px 0}.row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid #eee}.row:last-child{border-bottom:0}.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);max-width:480px;width:100%;background:#fff;border-top:1px solid #ddd;padding:10px 15px;display:flex;justify-content:space-between;align-items:center}
.modal-bg{display:none;position:fixed;inset:0;background:#0007;z-index:10}.modal{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;max-height:90vh;overflow:auto;background:#fff;border-radius:20px 20px 0 0;padding:18px}.close{float:right;border:0;border-radius:50%;width:30px;height:30px}.toast{display:none;position:fixed;bottom:75px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:10px 14px;border-radius:9px;z-index:20}
</style><link rel="manifest" href="manifest.json">
