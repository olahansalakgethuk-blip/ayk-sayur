async function addBranch(){let name=document.getElementById("bnm").value.trim(),address=document.getElementById("bad").value.trim(),pass=document.getElementById("bpass").value;if(!name||pass.length<6)return toast("Nama cabang wajib dan password minimal 6 karakter");let id="cabang-"+Date.now();try{if(sbReady){let {error}=await sb.from("cabang").insert({id,nama:name,alamat:address,aktif:true});if(error)throw error; let ar=await sb.from("admin_cabang").insert({cabang_id:id,password:pass});if(ar.error)throw ar.error;}branches.push({id,name,address});saveBranches();let a=JSON.parse(localStorage.getItem("aykBranchAdmins")||"[]");a.push({branchId:id,password:pass});branchAdmins=a;localStorage.setItem("aykBranchAdmins",JSON.stringify(a));toast("Cabang berhasil dibuat");adminPage("branches",document.querySelectorAll(".tab")[3])}catch(e){toast("Gagal membuat cabang: "+e.message)}}
