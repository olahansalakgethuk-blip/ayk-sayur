</head><body><div class="app" id="app"></div><div class="toast" id="toast"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
// ================= SUPABASE =================
// Isi 2 nilai ini dari Supabase > Project Settings > API
const SUPABASE_URL = "https://fdsjfadhzcdybktvmmlr.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_Yub4LlWj72i2V2AfMxTl8A_5tB0AkpI";
const sbReady = SUPABASE_URL.startsWith("https://") && SUPABASE_ANON_KEY.length > 20;
const sb = sbReady ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;
const initialProducts=[
{id:1,name:"Kangkung",price:5000,cost:3000,stock:20,emoji:"🥬",unit:"ikat",package5k:true,packageUnit:"ikat"},
{id:2,name:"Bayam",price:5000,cost:3000,stock:20,emoji:"🌿",unit:"ikat",package5k:true,packageUnit:"ikat"},
{id:3,name:"Tomat",price:12000,cost:8000,stock:15,emoji:"🍅",unit:"kg",package5k:true,packageUnit:"250 gram"},
{id:4,name:"Wortel",price:14000,cost:9000,stock:15,emoji:"🥕",unit:"kg",package5k:true,packageUnit:"250 gram"},
{id:5,name:"Cabai Merah",price:45000,cost:35000,stock:10,emoji:"🌶️",unit:"kg",package5k:true,packageUnit:"100 gram"},
{id:6,name:"Bawang Merah",price:38000,cost:28000,stock:10,emoji:"🧅",unit:"kg",package5k:true,packageUnit:"100 gram"}];
let products=JSON.parse(localStorage.getItem("aykProducts")||"null")||initialProducts;
products=products.map(p=>({...p,package5k:p.package5k!==false,packageUnit:p.packageUnit||((p.unit||"").toLowerCase()==="ikat"?"ikat":((p.unit||"").toLowerCase()==="kg"?"250 gram":"1 paket"))}));
let orders=JSON.parse(localStorage.getItem("aykOrders")||"[]"),cart={},role=null;
let branches=JSON.parse(localStorage.getItem("aykBranches")||"null")||[{id:"pusat",name:"AYK SAYUR Pusat",address:"Pusat"}];
let branchOverrides={}; let branchAdmins=[]; let adminMode="pusat"; let currentBranchId="pusat";
function currentBranch(){return branches.find(b=>String(b.id)===String(currentBranchId))||branches[0];}
function branchName(id){return (branches.find(b=>String(b.id)===String(id))||{}).name||"AYK SAYUR Pusat";}
function branchProductsView(){return products.map(p=>{let ov=branchOverrides[String(p.id)]||{}; return {...p,price:ov.price!=null?Number(ov.price):p.price,stock:ov.stock!=null?Number(ov.stock):p.stock,basePrice:p.price,baseStock:p.stock}});}
function saveBranches(){localStorage.setItem("aykBranches",JSON.stringify(branches));}
async function loadBranches(){if(!sbReady)return;try{const {data,error}=await sb.from("cabang").select("*").eq("aktif",true).order("id");if(error)throw error;if(data?.length){branches=data.map(x=>({id:x.id,name:x.nama,address:x.alamat||""}));saveBranches();} const ar=await sb.from("admin_cabang").select("*"); if(!ar.error) branchAdmins=(ar.data||[]).map(x=>({branchId:x.cabang_id,password:x.password})); localStorage.setItem("aykBranchAdmins",JSON.stringify(branchAdmins)); }catch(e){console.error(e)}}
async function loadBranchOverrides(branchId=currentBranchId){branchOverrides={}; if(!sbReady)return; try{const {data,error}=await sb.from("produk_cabang").select("*").eq("cabang_id",branchId);if(error)throw error;(data||[]).forEach(x=>branchOverrides[String(x.produk_id)]={price:x.harga_khusus,stock:x.stock});}catch(e){console.error(e)}}
async function applyBranchView(){await loadBranchOverrides(currentBranchId); products=products.map(p=>{let ov=branchOverrides[String(p.id)]||{};return {...p,price:ov.price!=null?Number(ov.price):p.basePrice??p.price,stock:ov.stock!=null?Number(ov.stock):p.baseStock??p.stock};});}


function mapProduct(r){return {id:r.id,name:r.nama,price:Number(r.harga||0),cost:Number(r.modal||0),stock:Number(r.stock||0),emoji:r.emoji||"🥦",unit:r.satuan||"kg",package5k:r.paket5k_aktif!==false,packageUnit:r.paket5k_satuan||((r.satuan||"").toLowerCase()==="ikat"?"ikat":((r.satuan||"").toLowerCase()==="kg"?"250 gram":"1 paket")),category:r.kategori||"",foto:r.foto||"",aktif:r.aktif!==false,basePrice:Number(r.harga||0),baseStock:Number(r.stock||0)}}
async function loadOnlineData(){
  if(!sbReady){toast("Mode lokal: Supabase belum diisi");return;}
  try{
    const {data,error}=await sb.from("produk").select("*").order("id");
    if(error) throw error;
    products=(data||[]).filter(x=>x.aktif!==false).map(mapProduct);
    products=products.map(p=>({...p,basePrice:p.basePrice??p.price,baseStock:p.baseStock??p.stock}));
    await loadBranches();
    if(role==="buyer"||adminMode==="cabang") await applyBranchView();
    localStorage.setItem("aykProducts",JSON.stringify(products));
    const {data:ord,error:oe}=await sb.from("pesanan").select("*").order("created_at",{ascending:false}).limit(100);
    if(!oe) orders=(ord||[]).map(o=>({id:o.id,date:o.created_at?new Date(o.created_at).toLocaleString("id-ID"):"",name:o.nama_pelanggan,phone:o.whatsapp,address:o.alamat,subtotal:Number(o.subtotal||0),shipping:Number(o.ongkir||0),shippingZone:o.zona,total:Number(o.total||0),profit:Number(o.profit||0),items:o.items||[],payment:o.metode_pembayaran,status:o.status,proof:o.bukti_pembayaran||"",branchId:o.cabang_id||"pusat",branchName:o.cabang_nama||branchName(o.cabang_id||"pusat"),latitude:Number(o.latitude)||null,longitude:Number(o.longitude)||null}));
    localStorage.setItem("aykOrders",JSON.stringify(orders));
    if(role==="buyer") renderShop();
    if(role==="admin") adminApp();
  }catch(e){console.error(e);toast("Gagal mengambil data Supabase: "+e.message);}
}

let shipping=JSON.parse(localStorage.getItem("aykShipping")||"null")||{z1:5000,z2:10000,z3:15000,free:100000};
let payment=JSON.parse(localStorage.getItem("aykPayment")||"null")||{bank:"BCA",account:"1234567890",holder:"AYK SAYUR",qris:"QRIS belum diatur"};
const rp=n=>new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(n);
function save(){localStorage.setItem("aykProducts",JSON.stringify(products));localStorage.setItem("aykOrders",JSON.stringify(orders))}
async function syncProduct(p){if(!sbReady)return;if(adminMode==="cabang"&&currentBranchId!=="pusat"){let payload={cabang_id:currentBranchId,produk_id:p.id,harga_khusus:p.price,stock:p.stock};const {error}=await sb.from("produk_cabang").upsert(payload,{onConflict:"cabang_id,produk_id"});if(error)throw error;return;}const {error}=await sb.from("produk").update({harga:p.price,modal:p.cost,stock:p.stock,satuan:p.unit,paket5k_aktif:p.package5k,paket5k_satuan:p.packageUnit,foto:p.foto||""}).eq("id",p.id);if(error)throw error}
async function syncProductForCurrentBranch(p){if(!sbReady)return;if(String(currentBranchId)!=="pusat"){let ov=branchOverrides[String(p.id)]||{};let payload={cabang_id:currentBranchId,produk_id:p.id,harga_khusus:ov.price!=null?ov.price:null,stock:p.stock};const {error}=await sb.from("produk_cabang").upsert(payload,{onConflict:"cabang_id,produk_id"});if(error)throw error;}else{const {error}=await sb.from("produk").update({stock:p.stock}).eq("id",p.id);if(error)throw error;}}
async function uploadProductPhoto(id){if(adminMode!=="pusat")return toast("Upload foto dilakukan oleh Admin Pusat");
  const input=document.getElementById("foto"+id), file=input?.files?.[0];
  if(!file)return toast("Pilih foto terlebih dahulu");
  if(!sbReady)return toast("Supabase belum tersambung");
  if(!file.type.startsWith("image/"))return toast("File harus berupa gambar");
  if(file.size>5*1024*1024)return toast("Ukuran foto maksimal 5 MB");
  const p=products.find(x=>x.id==id); if(!p)return;
  const ext=(file.name.split(".").pop()||"jpg").toLowerCase().replace(/[^a-z0-9]/g,"")||"jpg";
  const path=id+"/"+Date.now()+"."+ext;
  try{
    const {error:ue}=await sb.storage.from("produk").upload(path,file,{upsert:true,contentType:file.type});
    if(ue)throw ue;
    const {data}=sb.storage.from("produk").getPublicUrl(path);
    p.foto=data.publicUrl;
    await syncProduct(p); save(); adminApp(); toast("Foto produk tersimpan online");
  }catch(e){console.error(e);toast("Gagal upload foto: "+e.message+". Pastikan bucket 'produk' sudah dibuat Public.")}
}
async function insertProduct(p){if(!sbReady)return;const {data,error}=await sb.from("produk").insert({nama:p.name,kategori:p.category||"sayuran",harga:p.price,modal:p.cost,stock:p.stock,satuan:p.unit,aktif:true,paket5k_aktif:p.package5k,paket5k_satuan:p.packageUnit}).select().single();if(error)throw error; p.id=data.id}
async function syncOrder(o){if(!sbReady)return;const {error}=await sb.from("pesanan").insert({id:o.id,nama_pelanggan:o.name,whatsapp:o.phone,alamat:o.address,latitude:o.latitude,longitude:o.longitude,subtotal:o.subtotal,ongkir:o.shipping,zona:o.shippingZone,total:o.total,profit:o.profit,metode_pembayaran:o.payment,status:o.status,bukti_pembayaran:o.proof||"",items:o.items,cabang_id:o.branchId||"pusat",cabang_nama:o.branchName||branchName(o.branchId||"pusat")});if(error)throw error}
async function syncOrderStatus(id,status){if(!sbReady)return;const {error}=await sb.from("pesanan").update({status}).eq("id",id);if(error)throw error}
function toast(t){let e=document.getElementById("toast");e.textContent=t;e.style.display="block";setTimeout(()=>e.style.display="none",1300)}
function landing(){role=null;document.getElementById("app").innerHTML=`<header><h1>🥬 AYK SAYUR</h1><p>Sayur Segar, Belanja Praktis</p></header><div class="page role"><h2>Masuk sebagai</h2><div class="role-card" onclick="buyerLogin()"><div class="role-icon">👤</div><b>PEMBELI</b><small>Belanja sayuran dan lihat pesanan</small></div><div class="role-card" onclick="adminLogin()"><div class="role-icon">🔐</div><b>ADMIN</b><small>Kelola produk, stok, paket & transaksi</small></div></div>`}
function buyerLogin(){role="buyer";buyerApp()}
function getAdminPassword(){return localStorage.getItem("aykAdminPassword")||"1234"}
function adminLogin(){document.getElementById("app").innerHTML=`<header><h1>🥬 AYK SAYUR</h1><p>Login Administrator</p></header><div class="page login"><h2>🔐 Masuk Admin</h2><label>Jenis Admin</label><select id="adminType" class="input" onchange="toggleBranchLogin()"><option value="pusat">Admin Pusat</option><option value="cabang">Admin Cabang</option></select><div id="branchLoginBox" style="display:none"><label>Pilih Cabang</label><select id="loginBranch" class="input">${branches.filter(b=>b.id!=="pusat").map(b=>`<option value="${b.id}">${b.name}</option>`).join("")||`<option value="">Belum ada cabang</option>`}</select></div><label>Password admin</label><div style="display:flex;gap:6px"><input id="adminPass" class="input" style="flex:1" type="password" placeholder="Masukkan password" onkeydown="if(event.key==='Enter')checkAdmin()"><button class="btn light" type="button" onclick="togglePwd('adminPass',this)">👁️</button></div><button class="btn green full" onclick="checkAdmin()">Masuk</button><button class="btn light full" style="margin-top:8px" onclick="landing()">← Kembali</button><p style="font-size:12px;color:#777">Password Admin Pusat awal: <b>1234</b>.</p></div>`;toggleBranchLogin()}
function toggleBranchLogin(){let t=document.getElementById("adminType")?.value,b=document.getElementById("branchLoginBox");if(b)b.style.display=t==="cabang"?"block":"none"}
function checkAdmin(){let type=document.getElementById("adminType").value; if(type==="pusat"){if(document.getElementById("adminPass").value===getAdminPassword()){role="admin";adminMode="pusat";currentBranchId="pusat";adminApp()}else toast("Password salah")}else{let id=document.getElementById("loginBranch").value,pass=document.getElementById("adminPass").value;let u=branchAdmins.find(x=>String(x.branchId)===String(id))||JSON.parse(localStorage.getItem("aykBranchAdmins")||"[]").find(x=>String(x.branchId)===String(id));if(u&&u.password===pass){role="admin";adminMode="cabang";currentBranchId=id;adminApp()}else toast("Password cabang salah")}}
function changeAdminPassword(){let old=document.getElementById("oldAdminPass").value,newp=document.getElementById("newAdminPass").value,conf=document.getElementById("confirmAdminPass").value;if(old!==getAdminPassword())return toast("Password lama salah");if(newp.length<6)return toast("Password baru minimal 6 karakter");if(newp!==conf)return toast("Konfirmasi password tidak sama");localStorage.setItem("aykAdminPassword",newp);toast("Password admin berhasil diganti");document.getElementById("oldAdminPass").value="";document.getElementById("newAdminPass").value="";document.getElementById("confirmAdminPass").value=""}
function buyerApp(){document.getElementById("app").innerHTML=`<header><h1>🥬 AYK SAYUR</h1><p>Selamat datang, Pembeli</p></header><div class="top"><b>🛒 Belanja</b><button class="btn light" onclick="showBuyerOrders()">📦 Pesanan</button><button class="btn light" onclick="landing()">Keluar</button></div><div class="page"><input id="search" class="input" placeholder="🔎 Cari sayuran..." oninput="renderShop()"><select id="branchFilter" class="input" onchange="changeBuyerBranch(this.value)">${branches.map(b=>`<option value="${b.id}" ${String(b.id)===String(currentBranchId)?"selected":""}>🏪 ${b.name}</option>`).join("")}</select><select id="catFilter" class="input" onchange="renderShop()"><option value="">📂 Semua kategori</option>${[...new Set(products.map(p=>p.category).filter(Boolean))].sort().map(c=>`<option value="${c}">${c}</option>`).join("")}</select><div class="panel"><b>🎁 Paket Serba 5K</b><br><small>Pilih produk yang tersedia dalam paket Rp5.000.</small></div><div id="shopProducts" class="product-grid"></div></div><div class="bottom"><div>🛒 <b id="cartCount">0</b> item · <b id="cartTotal">Rp0</b></div><button class="btn green" onclick="openCart()">Checkout</button></div>`;renderShop()}
async function changeBuyerBranch(id){currentBranchId=id;await loadOnlineData();renderShop()}
function renderShop(){products=branchProductsView();let q=(document.getElementById("search")?.value||"").toLowerCase(),cat=document.getElementById("catFilter")?.value||"";let a=products.filter(p=>p.aktif!==false&&(p.name||"").toLowerCase().includes(q)&&(!cat||p.category===cat));document.getElementById("shopProducts").innerHTML=a.map(p=>`<div class="product">${p.foto?`<img src="${p.foto}" alt="${p.name}" style="width:100%;height:150px;object-fit:cover;border-radius:12px;margin-bottom:8px">`:`<div class="emoji">${p.emoji||"🥦"}</div>`}<h3>${p.name}</h3><div class="price">${rp(p.price)} / ${p.unit||"kg"}</div><small>Stok: ${p.stock}</small>${p.package5k?`<div class="package">🎁 <b>Paket 5K: ${rp(5000)}</b><br>${p.packageUnit}</div>`:""}<button class="btn green add" onclick="add(${p.id},'normal')" ${p.stock<=0?"disabled":""}>+ Normal</button>${p.package5k?`<button class="btn light add" onclick="add(${p.id},'package')">+ Paket 5K</button>`:""}</div>`).join("")}
function add(id,type){let p=products.find(x=>x.id==id);if(!p)return;let key=id+":"+type;let qty=Object.keys(cart).filter(k=>k.startsWith(id+":")) .reduce((s,k)=>s+cart[k],0);if(qty>=p.stock)return toast("Stok tidak cukup");cart[key]=(cart[key]||0)+1;updateCart();toast(type==="package"?p.name+" paket 5K ditambahkan":p.name+" ditambahkan")}
function changeCart(key,delta){let [id,type]=key.split(":");let p=products.find(x=>x.id==id);if(!p)return;let q=(cart[key]||0)+delta;if(q<=0){delete cart[key]}else{let other=Object.keys(cart).filter(k=>k!==key&&k.startsWith(id+":")).reduce((s,k)=>s+cart[k],0);if(other+q>p.stock)return toast("Stok tidak cukup");cart[key]=q}updateCart();renderCartModal()}
function cartLines(){return Object.entries(cart).map(([key,q])=>{let [id,type]=key.split(":");let p=products.find(x=>x.id==id);let price=type==="package"?5000:p.price;return {key,id,type,q,p,price,lineTotal:price*q}})}
function getCartSubtotal(){return cartLines().reduce((s,x)=>s+x.lineTotal,0)}
function updateCart(){let n=Object.values(cart).reduce((s,q)=>s+q,0),t=getCartSubtotal();let c=document.getElementById("cartCount"),ct=document.getElementById("cartTotal");if(c)c.textContent=n;if(ct)ct.textContent=rp(t);updateCheckoutTotal()}
function renderCartModal(){let ci=document.getElementById("ci");if(!ci)return;let lines=cartLines();ci.innerHTML=lines.length?lines.map(x=>`<div class="row" style="gap:8px;align-items:center;margin-bottom:8px"><span style="flex:1">${x.p.emoji||"🥦"} ${x.p.name} ${x.type==="package"?"🎁 5K":""}<br><small>${rp(x.price)} × ${x.q} = <b>${rp(x.lineTotal)}</b></small></span><span style="display:flex;gap:4px"><button class="btn light" onclick="changeCart('${x.key}',-1)">−</button><b style="padding:8px 4px">${x.q}</b><button class="btn light" onclick="changeCart('${x.key}',1)">+</button><button class="btn red" onclick="changeCart('${x.key}',-${x.q})">🗑️</button></span></div>`).join(""):"<p>Keranjang kosong.</p>";updateCart()}
function openCart(){let lines=cartLines();document.body.insertAdjacentHTML("beforeend",`<div class="modal-bg" id="cartModal"><div class="modal"><button class="close" onclick="document.getElementById('cartModal').remove()">×</button><h2>🛒 Keranjang</h2><div id="ci"></div><div id="checkoutTotal"></div><input id="bn" class="input" placeholder="Nama pelanggan"><input id="bp" class="input" placeholder="Nomor WhatsApp"><textarea id="ba" class="input" rows="3" placeholder="Alamat pengiriman"></textarea><div class="panel"><b>📍 Lokasi pengiriman</b><br><small>Gunakan lokasi perangkat atau buka Google Maps untuk menentukan titik pengiriman.</small><button type="button" class="btn light full" style="margin-top:8px" onclick="pickLocation()">📍 Pilih Lokasi di Google Maps</button><input id="bLat" type="hidden"><input id="bLng" type="hidden"><div id="locationInfo" style="font-size:12px;color:#555;margin-top:6px">Lokasi belum dipilih.</div></div><label><b>Wilayah pengiriman</b></label><select id="shipZone" class="input" onchange="updateCheckoutTotal()"><option value="z1">Zona 1 — Dekat (${rp(shipping.z1)})</option><option value="z2">Zona 2 — Sedang (${rp(shipping.z2)})</option><option value="z3">Zona 3 — Jauh (${rp(shipping.z3)})</option></select><div id="shipInfo" class="panel"></div><label><b>Metode pembayaran</b></label><select id="payMethod" class="input" onchange="showPayInfo()"><option value="COD">COD — Bayar saat diterima</option><option value="TRANSFER">Transfer Bank</option><option value="QRIS">QRIS</option></select><div id="payInfo" class="panel" style="display:none"></div><label style="display:block;margin-top:8px"><b>Bukti pembayaran</b> <small>(untuk Transfer/QRIS)</small></label><input id="proof" class="input" type="file" accept="image/*"><button class="btn green full" onclick="finishOrder()">✅ Buat Pesanan</button></div></div>`);document.getElementById("cartModal").style.display="block";renderCartModal();showPayInfo()}
function pickLocation(){const lat=document.getElementById("bLat"),lng=document.getElementById("bLng"),info=document.getElementById("locationInfo");if(navigator.geolocation){navigator.geolocation.getCurrentPosition(pos=>{lat.value=pos.coords.latitude.toFixed(6);lng.value=pos.coords.longitude.toFixed(6);info.innerHTML=`✅ Lokasi dipilih: ${lat.value}, ${lng.value}<br><a href="https://www.google.com/maps?q=${lat.value},${lng.value}" target="_blank">Buka Google Maps</a>`;},()=>{window.open("https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(document.getElementById("ba").value||""),"_blank");info.textContent="Google Maps dibuka berdasarkan alamat.";});}else window.open("https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(document.getElementById("ba").value||""),"_blank");}
